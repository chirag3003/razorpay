# Required. The agent loop cannot run without it.
ANTHROPIC_API_KEY=sk-ant-...

PORT=4100
# Origin allowed to call this API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
# Where the connection registry, policy and activity log are written.
DATA_DIR=./data

# Optional, Phase 5. Until this is set the /api/voice/* routes answer 501.
# SARVAM_API_KEY=
