DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Signs the human-session JWT issued on /api/auth/login and /api/auth/signup.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

PORT=4000

# Test-mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-key-secret

# Webhook signing secret set in the Razorpay dashboard for the /webhooks/razorpay endpoint
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Origin allowed to call this API (the Next.js storefront)
CORS_ORIGIN=http://localhost:3000
