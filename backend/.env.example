DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Signs the human-session JWT issued on /api/auth/login and /api/auth/signup.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

PORT=4000

# Test-mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-key-secret

# Webhook signing secret set in the Razorpay dashboard for the /webhooks/razorpay endpoint
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
# Logs every Razorpay request and its verbatim reply. Diagnostics only — prints request bodies,
# including customer contact details. Leave unset in normal use.
RAZORPAY_DEBUG=false

# Serves the Reserve Pay rail from a local simulator instead of Razorpay, because the S2S payment
# API is not provisioned on the account (see issues.md). Refuses to boot against an rzp_live_ key.
RESERVE_PAY_SIM=false
# Pending -> confirmed delay. Sized so the first "I've approved it" in chat honestly reports
# pending; 0 confirms instantly.
RESERVE_PAY_SIM_APPROVAL_DELAY_MS=20000
RESERVE_PAY_SIM_WEBHOOKS=true
RESERVE_PAY_SIM_WEBHOOK_DELAY_MS=500

# Origin allowed to call this API (the Next.js storefront)
CORS_ORIGIN=http://localhost:3000

# Admin dashboard auth (POST /api/admin/login), separate from the human-session JWT above.
# ADMIN_PASSWORD is the shared operator password; ADMIN_JWT_SECRET signs the admin token
# (use a different value from JWT_SECRET). Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-distinct-from-jwt-secret

# Storefront chat agent (POST /api/chat). Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Any model slug from https://openrouter.ai/models — this string is the whole provider swap.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Used if the primary errors or is rate-limited. Set empty to disable fallback.
OPENROUTER_FALLBACK_MODEL=openai/gpt-4.1-mini

# Public origin of the storefront. Sent to OpenRouter for attribution, and used to build the
# links inside chat widgets (order confirmation href, "see all results"). Also where
# GET /oauth/authorize redirects a human to approve a new agent connection (web/'s /agent-connect
# page — see web/issues.md).
PUBLIC_APP_URL=http://localhost:3000

# This backend's own externally-reachable origin — used to build the absolute URLs published in
# the MCP OAuth metadata documents (routes/oauth.ts). Point this at an ngrok tunnel, the same way
# the webhook receiver needs one, whenever a real remote MCP client (not just curl on localhost)
# needs to reach it.
#
# Every URL in both discovery documents — issuer, authorize, token, register, and the protected
# resource — is built from this value, and nothing derives it from the incoming request. Leave it
# on localhost behind a tunnel and a remote client reads back "register at http://localhost:4000",
# which it cannot reach: it reports a sign-in failure and no request ever arrives here. Set this
# to the tunnel's https origin and RESTART (.env is read once at boot; --watch does not watch it).
OAUTH_ISSUER_URL=http://localhost:4000
